    purpose: "Retrieve approved product or support knowledge."
    risk_level: "low"
    access: "read-only"

  - name: "create_handoff_summary"
    purpose: "Create a structured summary for the selected expert or queue."
    risk_level: "medium"
    access: "write-draft"

  - name: "send_handoff"
    purpose: "Send the approved summary to an expert or queue."
    risk_level: "high"
    access: "write-action"
