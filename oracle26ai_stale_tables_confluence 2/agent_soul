from pathlib import Path
from guardrails import GuardrailAgent
from agents import Runner

EXPERT_ROUTER_INSTRUCTIONS = Path("Soul.md").read_text()

agent = GuardrailAgent(
    config=Path("guardrails_config.json"),
    name="Expert Router Agent",
    instructions=EXPERT_ROUTER_INSTRUCTIONS,
    tools=[
        search_experts,
        get_expert_profile,
        search_topic_access,
        search_knowledge_base,
        create_handoff_summary,
        send_handoff,
    ],
    handoffs=[
        identity_access_support_agent,
        cloud_integrations_support_agent,
        security_incident_support_agent,
        general_support_triage_agent,
    ],
)

result = await Runner.run(
    agent,
    "Who can help with Product Atlas Kubernetes connector failures?"
)

print(result.final_output)
```

